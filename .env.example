# Copy to .env.local and fill in. .env.local is gitignored: never commit real keys.
# Get a key pair at https://cloud.livekit.io/settings/keys

# LiveKit Cloud project (used by the agent worker and by the web client)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google AI Studio key for the Gemini realtime model that powers Jzbedin's voice
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Agent-controlled browser. Set to 1 to hide the Chromium window.
JZBEDIN_BROWSER_HEADLESS=

# Where the screenshot tool saves PNGs. Defaults to ./screenshots
JZBEDIN_BROWSER_SCREENSHOT_DIR=
